# Copy this file to .env and adjust values for your environment.
# Never commit the real .env file.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of hosts/IPs trusted for readiness/startup probes (not currently enforced, reserved for future use)
APP_VERSION=0.1.0

# --- Database ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=shipyard
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_DB=shipyard

# --- Grafana (docker-compose only) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-local-env
